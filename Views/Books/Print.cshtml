@model IEnumerable<LibraryManagementSystem.Models.Book>


@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <title>Borrow Report</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
     <style>
        body{
            padding:30px;
            font-family:Arial,Helvetica,sans-serif;
        }
        h2{
            text-align:center;
            font-weight:bold;
            margin-bottom:5px;
        }
        h4{
            text-align:center;
            color:#555;
            margin-bottom:30px;
        }
        table{
            width:100%;
        }
        th{
            background:#343a40 !important;
            color:white !important;
            text-align:center;
        }
        td{
            text-align:center;
            vertical-align:middle;
        }
        .footer{
            margin-top:30px;
            text-align:right;
            color:#666;
            font-size:14px;
        }
        @@media print{

            .no-print{
                display:none;
            }
        }
        </style>
    </head>
  <body>

     <h2>📚 Library Management System</h2>
     <h4>Books Report</h4>
     
      <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th class="">Title</th>
                <th class="">ISBN</th>
                <th class="">Total Copies</th>
                <th class="">Available Copies</th>
                <th class="">Category</th>
                <th class="">Author</th>
                <th class="">Publisher</th>
            </tr>
        </thead>
        <tbody>
        <tbody>
        @foreach(Book item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.ISBN</td>
                <td>@item.TotalCopies</td>
                <td>@item.AvailableCopies</td>
                <td>@item.Category?.Name</td>
                <td>@item.Author?.Name</td>
                <td>@item.Publisher?.Name</td>
               
            </tr>
        }
        </tbody>
    </table>
    <div class="footer">
        Printed On :
        @DateTime.Now.ToString("dd MMM yyyy hh:mm tt")
    </div>
    <script>
        window.onload = function () {
            window.print();
        };
    </script>



    </body>
    </html>


<script>
    window.onload = function(){
        setTimeout(function(){

        window.print();
        },500);
    }
    window.onafterprint = function(){
        setTimeout(function(){
        window.close();
        },500);
    }
</script>