@model IEnumerable<LibraryManagementSystem.Models.Borrow>

 <div class=" border shadow rounded mt-2">
    <h1 class="ms-2" >@ViewData["Title"]</h1>
 </div>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <title>Borrow Report</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
     <style>
        body{
            padding:30px;
            font-family:Arial,Helvetica,sans-serif;
        }
        h2{
            text-align:center;
            font-weight:bold;
            margin-bottom:5px;
        }
        h4{
            text-align:center;
            color:#555;
            margin-bottom:30px;
        }
        table{
            width:100%;
        }
        th{
            background:#343a40 !important;
            color:white !important;
            text-align:center;
        }
        td{
            text-align:center;
            vertical-align:middle;
        }
        .footer{
            margin-top:30px;
            text-align:right;
            color:#666;
            font-size:14px;
        }
        @@media print{

            .no-print{
                display:none;
            }
        }
        </style>
    </head>
  <body>

     <h2>📚 Library Management System</h2>
     <h4>Borrow Report</h4>
     
      <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Book</th>
                <th>Member</th>
                <th>Borrow Date</th>
                <th>Due Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
        <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>@item.Book?.Title</td>
                <td>@item.Member?.Name</td>
                <td>@item.BorrowDate.ToString("dd MMM yyyy")</td>
                <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                <td>
                    @if(item.ReturnDate != null)
                    {
                        <span>Returned</span>
                    }
                    else if(item.DueDate < DateTime.Today)
                    {
                        <span>OverDue</span>
                    }
                    else
                    {
                        <span>Borrowed</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    <div class="footer">
        Printed On :
        @DateTime.Now.ToString("dd MMM yyyy hh:mm tt")
    </div>
    <script>
        window.onload = function () {
            window.print();
        };
    </script>



    </body>
    </html>


<script>
    window.onload = function(){
        window.print();
    }
    window.onload = function(){
        window.close();
    }
</script>