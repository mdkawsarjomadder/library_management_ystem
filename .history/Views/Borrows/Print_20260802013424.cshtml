@model IEnumerable<LibraryManagementSystem.Models.Borrow>

 <div class=" border shadow rounded mt-2">
    <h1 class="ms-2" >@ViewData["Title"]</h1>
 </div>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <title>Borrow Report</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
     <style>
        body{
            padding:30px;
            font-family:Arial,Helvetica,sans-serif;
        }
        h2{
            text-align:center;
            font-weight:bold;
            margin-bottom:5px;
        }
        h4{
            text-align:center;
            color:#555;
            margin-bottom:30px;
        }
        table{
            width:100%;
        }
        th{
            background:#343a40 !important;
            color:white !important;
            text-align:center;
        }
        td{
            text-align:center;
            vertical-align:middle;
        }
        .footer{
            margin-top:30px;
            text-align:right;
            color:#666;
            font-size:14px;
        }
        @@media print{

            .no-print{
                display:none;
            }
        }
        </style>
    </head>
  <body>

     <h2>📚 Library Management System</h2>
     <h4>Borrow Report</h4>
  </body>
