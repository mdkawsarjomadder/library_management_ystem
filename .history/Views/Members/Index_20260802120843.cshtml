@model IEnumerable<LibraryManagementSystem.Models.Member>
    @{
        ViewData["Title"] = "Member List";
    }


     <!-- # Add a Members -->
    <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
        <div>
            <h2 class="fw-bold mb-1">
                👤 Members Management
            </h2>
            <p class="text-muted fs-5 mb-3 ms-5">
                Manage library members
            </p>
        </div>

        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add Member
        </a>
   </div>

   <!-- #Search Button Create --    --------------------------->
      <div class="table-responsive shadow rounded">
        <table class="table table-bordered table-hover dataTable table-striped text-center align-middle mb-0">
       
        <p class="ms-4">
            <h1>Member List</h1>
        </p>
          <thead class="table-dark">
             <tr class="text-white text-center">
                 <th>Name</th>
                 <th>Email</th>
                 <th>Phone</th>
                 <th>Address</th>
                 <th>Action</th>

             </tr>
          </thead>
        <tbody>
    @foreach(var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>@item.Address</td>
                <!-- Edit and Delete function -->
                <td class="text-center">

                <!-- Details Button -->
            <a asp-action="Details"
                asp-route-id="@item.Id"
                class="btn btn-info btn-sm">
                <i class="bi bi-eye"></i> Details
            </a>

         
                <!-- Delete -->
             <a href="#"
                  class="btn btn-danger btn-delete"
                    data-url="@Url.Action("Delete", new { id = item.Id })">
                    <i class="bi bi-trash"></i>
                    Delete
                </a>


                </td>
            </tr>

        }
         </tbody>
    </table>
