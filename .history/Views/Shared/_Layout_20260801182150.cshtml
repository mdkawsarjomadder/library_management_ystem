@using Microsoft.AspNetCore.Identity
@using LibraryManagementSystem.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LibraryManagementSystem</title>

    <script type="importmap"></script>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LibraryManagementSystem.styles.css" asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- DataTables -->
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />

    <!-- Loader -->
    <style>
        #loader {
            position: fixed;
            inset: 0;
            background: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 99999;
        }

        #loader.hidden {
            display: none;
        }
    </style>
</head>

<body>

    <!-- Loading Spinner -->
    <div id="loader">
        <div class="spinner-border text-primary"
             style="width:4rem;height:4rem;"
             role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    @{
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();

        var currentUser = await UserManager.GetUserAsync(User);

        string initials = "";

        if (!string.IsNullOrWhiteSpace(currentUser?.Name))
        {
            var parts = currentUser.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

            if (parts.Length == 1)
            {
                initials = parts[0][0].ToString().ToUpper();
            }
            else
            {
                initials = $"{parts[0][0]}{parts[1][0]}".ToUpper();
            }
        }
    }

<header>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm fixed-top">

    <div class="container">

        <!-- Logo -->
        <a class="navbar-brand fw-bold fs-3"
           asp-controller="Home"
           asp-action="Index">
            📚 LibraryMS
        </a>

        <!-- Mobile Toggle -->
        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbar"
                aria-controls="mainNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">

            @if (SignInManager.IsSignedIn(User))
            {
                <!-- Center Menu -->
                <ul class="navbar-nav mx-auto">

                    <li class="nav-item">
                        <a class="nav-link @(currentController=="Home" && currentAction=="Index" ? "active fw-bold text-warning" : "")"
                           asp-controller="Home"
                           asp-action="Index">
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController=="Books" ? "active fw-bold text-warning" : "")"
                           asp-controller="Books"
                           asp-action="Index">
                            Books
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController=="Members" ? "active fw-bold text-warning" : "")"
                           asp-controller="Members"
                           asp-action="Index">
                            Members
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController=="Borrows" ? "active fw-bold text-warning" : "")"
                           asp-controller="Borrows"
                           asp-action="Index">
                            Borrows
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController=="Home" && currentAction=="About" ? "active fw-bold text-warning" : "")"
                           asp-controller="Home"
                           asp-action="About">
                            About
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController=="Home" && currentAction=="Contact" ? "active fw-bold text-warning" : "")"
                           asp-controller="Home"
                           asp-action="Contact">
                            Contact
                        </a>
                    </li>

                </ul>

                <!-- User -->
                <ul class="navbar-nav ms-auto align-items-center">

                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle d-flex align-items-center"
                           href="#"
                           id="userDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">

                            @if (string.IsNullOrEmpty(currentUser?.ProfileImage))
                            {
                                <div class="avatar-circle">
                                    @initials
                                </div>
                            }
                            else
                            {
                                <img src="@Url.Content("~/uploads/profile/" + currentUser.ProfileImage)"
                                     class="avatar-img"
                                     alt="Profile" />
                            }

                            <span class="avatar-name ms-2">
                                @currentUser?.Name
                            </span>

                        </a>

                        <ul class="dropdown-menu dropdown-menu-end bg-success"
                            aria-labelledby="userDropdown">

                            <li>
                                <h6 class="dropdown-header text-center fw-bold">
                                    @currentUser?.Name
                                </h6>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Account"
                                   asp-action="Profile">
                                    <i class="bi bi-person"></i>
                                    My Profile
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Account"
                                   asp-action="ChangePassword">
                                    <i class="bi bi-key"></i>
                                    Change Password
                                </a>
                            </li>

                            <li><hr class="dropdown-divider bg-white"></li>

                            <li>
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right"></i>
                                        Logout
                                    </button>

                                </form>
                            </li>

                        </ul>

                    </li>

                </ul>
            }
            else
            {
                <ul class="navbar-nav ms-auto align-items-center">

                    <li class="nav-item me-2">

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn login-btn rounded-pill px-4 fw-bold shadow-sm">

                            <i class="bi bi-box-arrow-in-right"></i>
                            Login

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="Account"
                           asp-action="Register"
                           class="btn rounded-pill px-4 fw-bold text-white shadow-sm"
                           style="background:linear-gradient(90deg,#0d6efd,#6610f2);border:none;">

                            <i class="bi bi-person-plus-fill"></i>
                            Register

                        </a>

                    </li>

                </ul>
            }

        </div>

    </div>

</nav>

</header>

<div class="container">
    <main role="main" class="pb-3 mt-3">
        @RenderBody()
    </main>
</div>

<!-- Footer -->
<footer class="bg-dark text-white text-center py-3 mt-auto">
    <div class="container">
        <span>
            © @DateTime.Now.Year Library Management System
        </span>
        <p class="mb-0">
            ASP.NET Core MVC
        </p>
    </div>
</footer>

<!-- jQuery -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<!-- Bootstrap -->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<!-- DataTables -->
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<!-- Site JS -->
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
<!-- Bootstrap Toast -->
@if (TempData["Success"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="successToast"
             class="toast align-items-center text-bg-success border-0"
             role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle-fill"></i>
                    @TempData["Success"]
                </div>
                <button type="button"
                        class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast">
                </button>
            </div>
        </div>
    </div>
}

<!-- SweetAlert Notifications -->
@if (TempData["Success"] != null)
{
    <script>
        Swal.fire({
            toast: true,
            position: "top-end",
            icon: "success",
            title: '@TempData["Success"]',
            showConfirmButton: false,
            timer: 2000,
            timerProgressBar: true
        });
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
        Swal.fire({
            toast: true,
            position: "top-end",
            icon: "error",
            title: '@TempData["Error"]',
            showConfirmButton: false,
            timer: 2000,
            timerProgressBar: true
        });
    </script>
}

<script>

document.addEventListener("DOMContentLoaded", function () {

    // Bootstrap Toast
    const toastEl = document.getElementById("successToast");

    if (toastEl) {
        const toast = new bootstrap.Toast(toastEl, {
            delay: 3000
        });

        toast.show();
    }

    // Delete Confirmation
    document.querySelectorAll(".btn-delete").forEach(button => {

        button.addEventListener("click", function (e) {

            e.preventDefault();

            const url = this.dataset.url;

            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to recover this record!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#3085d6",
                confirmButtonText: "Yes, Delete",
                cancelButtonText: "Cancel"

            }).then((result) => {

                if (result.isConfirmed) {
                    window.location.href = url;
                }

            });

        });

    });

    // DataTable
    if ($('.dataTable').length) {

        $('.dataTable').DataTable({

            responsive: true,
            pageLength: 10,
            lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, "All"]],
            ordering: true,
            searching: true,

            language: {
                search: "Search:",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_ to _END_ of _TOTAL_ entries",

                paginate: {
                    previous: "Previous",
                    next: "Next"
                }
            }

        });

    }

});

// Loader
window.addEventListener("load", function () {

    setTimeout(function () {

        const loader = document.getElementById("loader");

        if (loader) {
            loader.classList.add("hidden");
        }

    }, 400);

});

</script>

</body>
</html>