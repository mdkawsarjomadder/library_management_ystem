@using Microsoft.AspNetCore.Identity
@using LibraryManagementSystem.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LibraryManagementSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LibraryManagementSystem.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  
       
</head>
<body>
       @{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
}
    <header>
    

            @{
            var currentUser = await UserManager.GetUserAsync(User);
            }
            <!-- Image code------------ -->
            @{
                string initials = "";

                if(!string.IsNullOrWhiteSpace(currentUser?.Name))
                    {
                        var parts = currentUser.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

                        if(parts.Length == 1)
                          {
                            initials = parts[0][0].ToString().ToUpper();
                          }
                          else
                           {
                            initials =$"{parts[0][0]}{parts[1][0]}".ToUpper();
                           }
                    }
            }

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm fixed-top">
    <div class="container">

        <!-- Logo -->
        <a class="navbar-brand fw-bold fs-3"
           asp-controller="Home"
           asp-action="Index">
            📚 LibraryMS
        </a>

        <!-- Mobile Toggle -->
        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbar"
                aria-controls="mainNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Menu -->
        <div class="collapse navbar-collapse" id="mainNavbar">

            @if (SignInManager.IsSignedIn(User))
            {
                <!-- Center Menu -->
                <ul class="navbar-nav mx-auto">

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Home" ? "active fw-bold text-warning" : "")"
                           asp-controller="Home"
                           asp-action="Index">
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Books" ? "active fw-bold text-warning" : "")"
                           asp-controller="Books"
                           asp-action="Index">
                            Books
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Members" ? "active fw-bold text-warning" : "")"
                           asp-controller="Members"
                           asp-action="Index">
                            Members
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Borrows" ? "active fw-bold text-warning" : "")"
                           asp-controller="Borrows"
                           asp-action="Index">
                            Borrows
                        </a>
                    </li>

                </ul>

                <!-- Right Side -->
                <ul class="navbar-nav ms-auto align-items-center">

                    <li class="nav-item dropdown ">

                    <a class="nav-link dropdown-toggle d-flex align-items-center"
                    href="#"
                    id="userDropdown"
                    role="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">

                        @if(string.IsNullOrEmpty(currentUser?.ProfileImage))
                        {
                            <div class="avatar-circle">
                                @initials
                            </div>
                        }
                        else
                        {
                            <img src="@currentUser.ProfileImage" class="avatar-img" />
                        }
                        
                        <span class="ms-2">
                            @currentUser?.Name
                        </span>

                    </a>
                    <!-- Images code------------- -->
                    <a ></a>

                    <ul class="dropdown-menu dropdown-menu-end bg-success"
                        aria-labelledby="userDropdown">

                        <li class="">
                            <h6 class="dropdown-header text-center fw-bold">
                                @currentUser?.Name
                            </h6>
                        </li>

                        <li>
                            <a class="dropdown-item"
                            asp-controller="Account"
                            asp-action="Profile">
                                <i class="bi bi-person"></i>
                                My Profile
                            </a>
                        </li>

                        <li>
                            <a class="dropdown-item"
                            asp-controller="Account"
                            asp-action="ChangePassword">
                                <i class="bi bi-key"></i>
                                Change Password
                            </a>
                        </li>

                        <li><hr class="dropdown-divider bg-white"></li>

                        <li>
                            <form asp-controller="Account"
                                asp-action="Logout"
                                method="post">

                                <button type="submit" class="dropdown-item">
                                    <i class="bi bi-box-arrow-right"></i>
                                    Logout
                                </button>

                            </form>
                        </li>

                    </ul>

                </li>
                </ul>
            }
            else
            {
                <!-- Not Logged In -->
                <ul class="navbar-nav ms-auto align-items-center">

                    <li class="nav-item me-2">
                        <a asp-controller="Account"
                        asp-action="Login"
                        class="btn login-btn rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                    </li>

                    <li class="nav-item me-2">
                    <a asp-controller="Account"
                    asp-action="Register"
                    class="btn rounded-pill px-4 fw-bold text-white shadow-sm"
                    style="background: linear-gradient(90deg, #0d6efd, #6610f2); border:none;">
                        <i class="bi bi-person-plus-fill"></i> Register
                    </a>
                </li>   

                </ul>
            }

        </div>

    </div>
</nav>
 </header>
    <div class="container">
        <main role="main" class="pb-3 mt-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white text-center py-3 mt-auto">
        <div class="container">
           <span>
            © 2026 Library Management System 
           </span>
           <p>
            ASP.NET Core MVC
           </p>
        </div>
    </footer>


  <script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
