    @model LibraryManagementSystem.ViewModels.EditProfileViewModel
    @{
        ViewData["Title"] = "Edit Profile";
    }

   <div class="">
      <h1>
        @ViewData["Title"]
        </h1>
   </div>

    <div class="container mt-5">
        <div class="row justity-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-header bg-warning">
                        <h3 class="">
                            <i class="bi bi-pencil-square"></i>
                            Edit Profile
                        </h3>
                    </div>
                    <!--  -->
     <div class="card-body">

    <form asp-action="EditProfile"
          method="post"
          enctype="multipart/form-data">

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <!-- Profile Image -->
        <div class="text-center mb-4">

            @if (!string.IsNullOrEmpty(Model.ProfileImage))
            {
                <img src="@Model.ProfileImage"
                     class="rounded-circle shadow"
                     style="width:180px;
                            height:180px;
                            object-fit:cover;" />
            }
            else
            {
                <div class="avatar-circle mx-auto">
                    @Model.Name.Substring(0,1).ToUpper()
                </div>
            }

            <!-- Choose File নিচে -->
            <div class="mt-3">
                <input asp-for="ProfileImageFile"
                       type="file"
                       class="form-control"
                       accept="image/*" />
            </div>

            <span asp-validation-for="ProfileImageFile"
                  class="text-danger"></span>

        </div>

        <!-- Name -->
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name"
                   class="form-control"
                   placeholder="Enter your full name" />
            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>

        <!-- Email -->
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email"
                   class="form-control"
                   readonly />
        </div>

        <!-- Phone -->
        <div class="mb-4">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber"
                   class="form-control"
                   placeholder="01XXXXXXXXXX" />
            <span asp-validation-for="PhoneNumber"
                  class="text-danger"></span>
        </div>

        <!-- Buttons -->
        <div class="text-center">

            <button type="submit"
                    class="btn btn-success px-4">
                <i class="bi bi-check-circle"></i>
                Save Changes
            </button>

            <a asp-action="Profile"
               class="btn btn-secondary px-4">
                Cancel
            </a>

        </div>

    </form>

</div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts{
    <partial name="_ValidationScriptsPartial" />
    }