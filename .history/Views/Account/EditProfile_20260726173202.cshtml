    @model LibraryManagementSystem.ViewModels.EditProfileViewModel
    @{
        ViewData["Title"] = "Edit Profile";
    }

   <div class="">
      <h1>
        @ViewData["Title"]
        </h1>
   </div>

    <div class="container mt-5">
        <div class="row justity-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-header bg-warning">
                        <h3 class="">
                            <i class="bi bi-pencil-square"></i>
                            Edit Profile
                        </h3>
                    </div>
                    <!--  -->
                    <div class="card-body">
                        <form asp-action="EditProfile" method="post" enctype="multipart/form-data"
                        class="">
                        
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                         
                           <div class="mb-3">
                            <label asp-for="Name" class="ms-1"></label>
                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter your full name" />
                            <span asp-validation-for="Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="ms-1"></label>
                            <input asp-for="PhoneNumber"
                                   class="form-control"
                                   placeholder="01XXXXXXXXX" />
                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ProfileImageFile" class="form-label fw-bold">

                            </label>
                            <input  asp-for="ProfileImageFile"
                                type="file"
                                class="form-control"
                                accept="image/*">
                             <span asp-validation-for="ProfileImageFile"
                                     class="text-danger"></span>   
                        </div>

                         <button class="btn btn-success">
                            <i class="bi bi-check-circle"></i>
                            Save Changes
                        </button>

                        <a asp-action="Profile"
                           class="btn btn-secondary">
                            Cancel
                        </a>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts{
    <partial name="_ValidationScriptsPartial" />
    }