
    @model LibraryManagementSystem.Models.ApplicationUser
    @{
        ViewData["Title"] = "Profile";
    }

    <div class="mb-4 bg-light rounded shadow">
        <h1 class="text-dark fw-bold ms-3"> 
        @ViewData["Title"]
    </h1>
    </div>

    <div class="container mt-5">
         <div class="row justify-content-center">
            <div class="col-md-7">
                <div class="card shadow border-0">

                    <div class="card-header bg-dark text-white">
                        <h3 class="mb-0 d-flex align-items-center">

                             @if(!string.IsNullOrEmpty(Model.ProfileImage))
                             {
                                <img src="~/uploads/profile/@Model.ProfileImage" 
                                 asp-append-version="true"
                                 class="header-profile-img me-2"
                                />
                             }
                             else
                             {
                                <div class="header-avatar me-2">
                                    @Model.Name.Substring(0,1).ToUpper()
                                </div>
                            
                             }
                             My Profile
                        </h3>
                    </div> 

                    
<div class="card-body">

    <div class="row align-items-start">

        <!-- Left Side -->
        <div class="col-md-8 mt-5">

            <table class="table table-borderless">
                <tr>
                    <th width="30%">Name</th>
                    <td>@Model.Name</td>
                </tr>

                <tr>
                    <th>Email</th>
                    <td>@Model.Email</td>
                </tr>

                <tr>
                    <th>Phone</th>
                    <td>@Model.PhoneNumber</td>
                </tr>

                <tr>
                    <th>User Name</th>
                    <td>@Model.UserName</td>
                </tr>
            </table>

        </div>

        <!-- Right Side -->
        <div class="col-md-4 text-center">

            @if (!string.IsNullOrEmpty(Model.ProfileImage))
            {
                <img src="~/uploads/profile/@Model.ProfileImage"
                     asp-append-version="true"
                     class="profile-img" />
            }
            else
            {
                <div class="avatar-large">
                    @Model.Name.Substring(0,1).ToUpper()
                </div>
            }

            <h4 class="mt-3">@Model.Name</h4>
            <p class="text-muted">@Model.Email</p>

        </div>

    </div>

    <hr />

    <a asp-action="EditProfile"
       class="btn btn-warning w-100">
        <i class="bi bi-pencil-square"></i>
        Edit Profile
    </a>

</div>          
                </div>
            </div>
         </div>
    </div>