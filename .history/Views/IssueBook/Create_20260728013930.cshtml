
@model LibraryManagementSystem.Models.IssueBook
@{
    ViewData["Title"] = "Create";
}

<div class="bg-light rounded shadow ">
    <h1 class="ms-2 fw-bold">
        @ViewData["Title"]
    </h1>
</div>

<div class="d-flex justify-content-center-between align-items-center md-4">
    <div class="ms-2">
        <h2 class="fw-bold">
            📖 Issue Book
        </h2>
        <p class="text-muted mb-0 ms-3">
            Issue a book to a library member.
        </p>
    </div>

        <a asp-action="Index" class="btn btn-secondary">
             <i class="bi bi-arrow-left h4 "></i> 
              Back
        </a>
    
    </div>
    
        <div class="card shadow">
         <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                <i class="bi bi-book"></i>
                Book Issue Form
            </h4> 
         </div>
    

        <div class="card-body">
            <form  asp-action="Cretae" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Memeber-->
                <div class="mb-3">
                    <label asp-for="UserId" class="form-label ms-2"></label>
                    <select asp-for="UserId"
                    asp-items="ViewBag.Users"
                     class="form-select">
                      <option value=">--Select Name--<"></option>
                     </select>

                     <span asp-validation-for="UserId" 
                                class="text-danger">

                     </span>
                </div>
                <!-- Book -->
                <div class="mb-3">
                    <label asp-for="BookId" class="form-label ms-2"></label>
                    <select asp-for="BookId" 
                            asp-items="ViewBag.Books"
                            class="form-select ">
                            <option value=">--Select Books--<"></option>
                            </select>
                    <span asp-validation-for="BookId" class="text-danger"></span>
                </div>

                <!-- Issue Date-->
                <div class="md-3">
                    <label asp-for="IssueDate" class="form-label"></label>
                    <input asp-for="IssueDate"
                        type="date"
                        class="form-control"/>
                    <span asp-validation-for="IssueDate" class="text-danger"></span>
                </div>

                <!-- Due Date-->
                <div class="md-3">
                    <label asp-for="DueDate" class="form-label"></label>
                    <input asp-for="DueDate" 
                        type="date" class="form-control">
                    <span asp-validation-for="DueDate" class="text-danger"></span>
                </div>

                <!-- Button-->
                <button type="submit" 
                    class="btn btn-seccess">
                         <i class="bi bi-check-circle"></i>
                            Issue Book
                </button>
                <a asp-action="Index" 
                class="btn btn-secondary">
                 Cancel
                </a>
            </form>
        </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}