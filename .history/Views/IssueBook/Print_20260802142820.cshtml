@model IEnumerable<LibraryManagementSystem.Models.IssueBook>


@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <title>Borrow Report</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
     <style>
        body{
            padding:30px;
            font-family:Arial,Helvetica,sans-serif;
        }
        h2{
            text-align:center;
            font-weight:bold;
            margin-bottom:5px;
        }
        h4{
            text-align:center;
            color:#555;
            margin-bottom:30px;
        }
        table{
            width:100%;
        }
        th{
            background:#343a40 !important;
            color:white !important;
            text-align:center;
        }
        td{
            text-align:center;
            vertical-align:middle;
        }
        .footer{
            margin-top:30px;
            text-align:right;
            color:#666;
            font-size:14px;
        }
        @@media print{

            .no-print{
                display:none;
            }
        }
        </style>
    </head>
  <body>

     <h2>📚 Library Management System</h2>
     <h4>Books Report</h4>
     
      <table class="table table-bordered table-striped">
        <thead>
            <tr>
                 <th>Member</th>
                <th>Book</th>
                <th>Issue Date</th>
                <th>Due Date</th>
                <th>Status</th>
                <th>Action</th>
                <th>Fine</th>
            </tr>
        </thead>
        <tbody>
        <tbody>
        @foreach(IssueBook item in Model)
        {
            <tr>
                <td>@item.User?.Name</td>
                            <td>@item.Book?.Title</td>
                            <td>
                                @item.IssueDate.ToString("dd MMM yyyy")
                            </td>
                             <td>
                            @item.DueDate.ToString("dd MMM yyyy")
                          </td>
                            <td>
                            @if(item.IsReturned)
                            {
                                <span class="badge bg-success">
                                    Returned
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Issued
                                </span>
                            }
                         </td>

                        <td>
                            @if(!item.IsReturned)
                            {
                                <a asp-action="Return"
                                   asp-route-id="@item.Id"
                                   class="btn btn-success btn-sm">

                                    <i class="bi bi-arrow-return-left"></i>
                                    Return
                                </a>
                            }
                            else
                            {
                                <span class="text-success fw-bold">
                                    Completed
                                </span>
                            }

                             </td>
                            <td>
                                @if (item.Fine > 0)
                                {
                                    <span class="badge bg-danger fs-6 px-3 py-2">
                                        ৳ @item.Fine.ToString("0.00")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success fs-6 px-3 py-2">
                                        ৳0.00
                                    </span>
                                }
                            </td>
            </tr>
        }
        </tbody>
    </table>
    <div class="footer">
        Printed On :
        @DateTime.Now.ToString("dd MMM yyyy hh:mm tt")
    </div>
    <script>
        window.onload = function () {
            window.print();
        };
    </script>



    </body>
    </html>


<script>
    window.onload = function(){
        setTimeout(function(){

        window.print();
        },500);
    }
    window.onafterprint = function(){
        setTimeout(function(){
        window.close();
        },500);
    }
</script>