@model IEnumerable<LibraryManagementSystem.Models.IssueBook>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <title>Issue Book Report</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>

        body{
            padding:30px;
            font-family:Arial,Helvetica,sans-serif;
        }

        h2{
            text-align:center;
            font-weight:bold;
        }

        h4{
            text-align:center;
            color:#666;
            margin-bottom:30px;
        }

        table{
            width:100%;
        }

        th{
            background:#212529 !important;
            color:white !important;
            text-align:center;
        }

        td{
            text-align:center;
            vertical-align:middle;
        }

        .footer{
            margin-top:25px;
            text-align:right;
            color:#666;
            font-size:14px;
        }

    </style>

</head>

<body>

<div class="bg-dark text-white p-3 mb-4 rounded">
    <h2 class="mb-1 text-center">
        📚 Library Management System
    </h2>

    <h5 class="mb-0 text-center">
        Issue Book Report
    </h5>
</div>

<table class="table table-bordered table-striped">

    <thead>

    <tr>

        <th>Member</th>

        <th>Book</th>

        <th>Issue Date</th>

        <th>Due Date</th>

        <th>Status</th>

        <th>Fine</th>

    </tr>

    </thead>

    <tbody>

@foreach(var item in Model)
{
    <tr>

        <td>@item.User?.Name</td>

        <td>@item.Book?.Title</td>

        <td>@item.IssueDate.ToString("dd MMM yyyy")</td>

        <td>@item.DueDate.ToString("dd MMM yyyy")</td>

        <td>

            @if(item.IsReturned)
            {
                <span class="badge bg-success">
                    Returned
                </span>
            }
            else if(item.DueDate < DateTime.Today)
            {
                <span class="badge bg-danger">
                    OverDue
                </span>
            }
            else
            {
                <span class="badge bg-warning text-dark">
                    Issued
                </span>
            }

        </td>

        <td>

            @if(item.Fine > 0)
            {
                <span class="badge bg-danger">
                    ৳ @item.Fine.ToString("0.00")
                </span>
            }
            else
            {
                <span class="badge bg-success">
                    ৳0.00
                </span>
            }

        </td>

    </tr>
}

    </tbody>

</table>

<div class="footer">

Printed On :
@DateTime.Now.ToString("dd MMM yyyy hh:mm tt")

</div>

<script>

window.onload=function(){

    window.print();

};

window.onafterprint=function(){

    window.close();

};

</script>

</body>

</html>