@model IEnumerable<LibraryManagementSystem.Models.IssueBook>
@{
    ViewData["Title"] = "Issued Books";
}

 <div class=" rounded  shadow ">
    <h1 class="ms-2">@ViewData["Title"]</h1>
 </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="">
            <h2 class="fw-bold">📚 Issued Books</h2>
            <p class="text-muted mb-0 ms-4">
                Manage all issued books.
            </p>
        </div>
         <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Issue Book
        </a>

         
    </div>

    <div class="card shadow mt-2">
        <div class="card-header bg-dark text-white">
             <h4 class="mb-0">
                <i class="bi bi-book"></i>
                Issued Book List
            </h4>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-hover text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Member</th>
                        <th>Book</th>
                        <th>Issue Date</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th>Action</th>
                         <th>Fine</th>
                    </tr>
                </thead>
                <tbody class="">
                    @foreach(var item in Model)
                       {
                        <tr>
                            <td>@item.User?.Name</td>
                            <td>@item.Book?.Title</td>

                            <td>
                                @item.IssueDate.ToString("dd MMM yyyy")
                            </td>

                             <td>
                            @item.DueDate.ToString("dd MMM yyyy")
                          </td>

                            <td>

                            @if(item.IsReturned)
                            {
                                <span class="badge bg-success">
                                    Returned
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Issued
                                </span>
                            }

                         </td>


                        <td>

                            @if(!item.IsReturned)
                            {
                                <a asp-action="Return"
                                   asp-route-id="@item.Id"
                                   class="btn btn-success btn-sm">

                                    <i class="bi bi-arrow-return-left"></i>
                                    Return

                                </a>
                            }
                            else
                            {
                                <span class="text-success fw-bold">
                                    Completed
                                </span>
                            }

                             </td>

                             <td>
                                @if(item.Fine > 0)
                                    {
                                        <span class="badge bg-danger fs-3">
                                          ৳@item.Fine
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success fs-3">
                                             ৳0
                                        </span>
                                    }
                             </td>

                        </tr>
                       }
                </tbody>
            </table>
        </div>
    </div>