@model IEnumerable<LibraryManagementSystem.Models.Book>

@{
    ViewData["Title"] = "Book List";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <div>
        <h2 class="fw-bold mb-1">
            📚 Books Management
        </h2>
        <p class="text-muted fs-5 ms-3">
            Manage all library books efficiently.
        </p>
    </div>

    <div>
        <a asp-action="ExportToExcel" class="btn btn-success">
            <i class="bi bi-file-earmark-excel"></i> Export Excel
        </a>

        <a asp-action="ExportToPdf" class="btn btn-danger ms-2">
            <i class="bi bi-file-earmark-pdf"></i> Export PDF
        </a>

        <a asp-action="Create" class="btn btn-primary ms-2">
           <i class="bi bi-plus-circle"></i> Add Book
        </a>
    </div>
</div>

@* Table Create In a books *@
<div class="table-responsive shadow-lg rounded-3">
    <table class="table table-bordered table-striped table-hover dataTable text-center align-middle rounded mb-0" id="dataTable">
        <thead class="table-dark">
            <tr class="text-center">
                <th>Title</th>
                <th>ISBN</th>
                <th>Total Copies</th>
                <th>Available Copies</th>
                <th>Category</th>
                <th>Author</th>
                <th>Publisher</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.ISBN</td>
                <td>@item.TotalCopies</td>
                <td>@item.AvailableCopies</td>
                <td>@item.Category?.Name</td>
                <td>@item.Author?.Name</td>
                <td>@item.Publisher?.Name</td>

                <!-- Edit, Details, and Delete Function -->
                <td class="text-center">
                    <a asp-action="Details"
                        asp-route-id="@item.Id"
                        class="btn btn-info btn-sm">
                        <i class="bi bi-eye"></i> Details
                    </a>

                    <a asp-action="Edit"
                        asp-route-id="@item.Id"
                        class="btn btn-warning btn-sm text-dark">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                     
                    <a href="#"
                      class="btn btn-danger btn-sm btn-delete"
                        data-url="@Url.Action("Delete", new { id = item.Id })">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>