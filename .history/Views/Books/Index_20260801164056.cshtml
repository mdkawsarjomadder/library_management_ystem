@model IEnumerable<LibraryManagementSystem.Models.Book>

@{
    ViewData["title"] = "Book List";
}

        <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
            <div>
                <h2 class="fw-bold mb-1">
                   📚 Books Management
                </h2>
                <p class="text-muted fs-5 ms-5">
                    Manage all library books.
                </p>
            </div>

            <a asp-action="Create" class="btn btn-success">
               <i class="bi bi-plus-circle"></i> Add Book
            </a>
        </div>
   
    <form method="get" asp-action="Index" class="row g-2 mb-4 pt-2">

        <div class="col-md-4">
            <input type="text"
                name="searchString"
                value="@ViewBag.SearchString"
                class="form-control"
                placeholder="Search by Book Title." />
        </div>

        <div class="col-auto">
            <button type="submit" class="btn btn-primary">
                 Search
            </button>
        </div>

        <div class="col-auto">
            <a asp-action="Index" class="btn btn-secondary">
                Reset
            </a>
        </div>

    </form> 
      <!-- # Form end--> 
    
 
   <h2 class="fw-bold">Book List</h2>
        <p class="text-muted fs-5 mb-3 ms-3">
            Manage all library books efficiently.
        </p>





        
        <div class="mb-3">
            <a asp-action="ExportToExcel" class="btn btn-success">
                <i class="bi bi-file-earmark-excel"></i> Export Excel
            </a>

            <a asp-action="ExportToPdf" class="btn btn-danger ms-2">
                <i class="bi bi-file-earmark-pdf"></i> Export PDF
            </a>
        </div>

     @* Table Create In a books*@
    <div class="table-responsive shadow-lg rounded-3">
     <table id="dataTable"
     class="table table-bordered table-striped table-hover text-center align-middle rounded mb-0">
         
        <thead class="table-dark">
            <tr class="text-center">
                <th class="">Title</th>
                <th class="">ISBN</th>
                <th class="">Total Copies</th>
                <th class="">Available Copies</th>
                <th class="">Category</th>
                <th class="">Author</th>
                <th class="">Publisher</th>
                <th class="">Action</th>
            </tr>
        </thead>

        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.ISBN</td>
                <td>@item.TotalCopies</td>
                <td>@item.AvailableCopies</td>
                <td>@item.Category?.Name</td>
                <td>@item.Author?.Name</td>
                <td>@item.Publisher?.Name</td>

        <!-- Edit  and Delete Function............ --> 
            <td class="text-center">
                    
                <a asp-action="Details"
                    asp-route-id="@item.Id"
                    class="btn btn-info btn-sm">
                    <i class="bi bi-eye"></i> Details
                </a>
                 
                <a href="#"
                  class="btn btn-danger btn-delete"
                    data-url="@Url.Action("Delete", new { id = item.Id })">
                    <i class="bi bi-trash"></i>
                    Delete
                </a>
            </td>
            </tr>
        }
        </tbody>
    </table>
    </div>


        
