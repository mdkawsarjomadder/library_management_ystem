    @model IEnumerable<LibraryManagementSystem.Models.Borrow>
        @{
            ViewData["Title"] = "Dashboard";
        }  



    <!-- ================= Dashboard Header ================= -->

    <div class="mb-4">
        <h2 class="fw-bold">
            📚 Library Management Dashboard
        </h2>
        <p class="text-muted fs-5 mb-3 ms-5">
            Welcome to the Library Management Dashboard
        </p>
    </div>

    <!-- ================= Quick Actions ================= -->

    <div class="d-flex flex-wrap gap-2 mb-4 mt-2 ">
        <a asp-controller="Books"
        asp-action="Create"
        class="btn btn-primary">
            ➕ Add Book
        </a>
        <a asp-controller="Members"
        asp-action="Create"
        class="btn btn-success">
            👤 Add Member
        </a>
        <a asp-controller="Borrows"
        asp-action="Create"
        class="btn btn-warning text-dark">
            📚 Borrow Book
        </a>
        <a asp-controller="Borrows"
        asp-action="Index"
        class="btn btn-info text-white">
            📖 View Borrows
        </a>
    </div>

    <!-- ================= Statistics Cards ================= -->

    <div class="row g-4 mt-2">

        <!-- Total Books -->

        <div class="col-lg-4 col-md-6">
            <div class="card bg-primary text-white dashboard-card shadow-sm border-0 h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-book dashboard-icon"></i>
                    <h5 class="mt-3 fw-bold">
                        Total Books
                    </h5>
                    <h2 class="display-5 fw-bold">
                        @ViewBag.TotalBooks
                    </h2>
                </div>
            </div>
        </div>

        <!-- Members -->

        <div class="col-lg-4 col-md-6">
            <div class="card bg-success text-white dashboard-card shadow-sm border-0 h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-people-fill dashboard-icon"></i>
                    <h5 class="mt-3 fw-bold">
                        Total Members
                    </h5>
                    <h2 class="display-5 fw-bold">
                        @ViewBag.TotalMembers
                    </h2>
                </div>
            </div>
        </div>

        <!-- Borrowed -->
        <div class="col-lg-4 col-md-6">
            <div class="card bg-info text-white dashboard-card shadow-sm border-0 h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-arrow-left-right dashboard-icon"></i>
                    <h5 class="mt-3 fw-bold">
                        Borrowed Books
                    </h5>
                    <h2 class="display-5 fw-bold">
                        @ViewBag.BorrowedCount
                    </h2>
                </div>
            </div>
        </div>

        <!-- Returned -->
        <div class="col-lg-4 col-md-6">
            <div class="card bg-danger text-white dashboard-card shadow-sm border-0 h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-check-circle dashboard-icon"></i>
                    <h5 class="mt-3 fw-bold">
                        Returned Books
                    </h5>
                    <h2 class="display-5 fw-bold">
                        @ViewBag.ReturnedCount
                    </h2>
                </div>
            </div>
        </div>

        <!-- OverDue -->

        <div class="col-lg-4 col-md-6">
            <div class="card bg-warning text-dark dashboard-card shadow-sm border-0 h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-exclamation-triangle dashboard-icon"></i>
                    <h5 class="mt-3 fw-bold">
                        Total OverDue
                    </h5>
                    <h2 class="display-5 fw-bold">
                        @ViewBag.OverdueCount
                    </h2>
                </div>
            </div>
        </div>

        <!-- Available -->

        <div class="col-lg-4 col-md-6">
            <div class="card bg-secondary text-white dashboard-card shadow-sm border-0 h-100">
                <div class="card-body text-center py-4">
                    <i class="bi bi-book-half dashboard-icon"></i>
                    <h5 class="mt-3 fw-bold">
                        Available Books
                    </h5>
                    <h2 class="display-5 fw-bold">
                        @ViewBag.AvailableBooks
                    </h2>
                </div>
            </div>
      </div>

    </div>
    <hr class="my-4">

    <!-- ================= Library Statistics ================= -->

    <div class="card shadow mt-4">

    <div class="card-header bg-dark text-white">
        <h5 class="mb-0">
            📊 Library Statistics
        </h5>
    </div>

    <div class="card-body">

        <div style="height:420px;">
            <canvas id="ChartBorrowed"></canvas>
        </div>

    </div>

   </div>

        <!-- Monthly bar chart-->
        <div class="card shadow mt-4">
            <div class="card-header bg-primary text-white">
                 <h5 class="mb-0">
            📈 Monthly Issue Report
           </h5>
            </div>
            <div class="card-body">

            <div style="height:400px;">
                <canvas id="MonthlyChart"></canvas>
            </div>

          </div>
        </div>


    <!-- ================= Recent Borrow History ================= -->

    <h4 class="fw-bold mb-3">
        📋 Recent Borrow History
    </h4>
    <div class="table-responsive shadow-sm rounded overflow-hidden">
        <table  
         class="table table-hover table-striped dataTable table-bordered align-middle text-center mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Book</th>
                    <th>Member</th>
                    <th>Borrow Date</th>
                    <th>Due Date</th>
                    <th>Status</th>
                </tr>
             </thead>
            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.Book?.Title
                        </td>
                        <td>
                            @item.Member?.Name
                        </td>
                        <td>
                            @item.BorrowDate.ToString("dd MMM yyyy")
                        </td>
                        <td>
                            @item.DueDate.ToString("dd MMM yyyy")
                        </td>
                        <td>
                            @if (item.ReturnDate != null)
                            {
                                <span class="badge bg-success">
                                    Returned
                                </span>
                            }
                            else if (item.DueDate < DateTime.Today)
                            {
                                <span class="badge bg-danger">
                                    OverDue
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Borrowed
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ================= View All ================= -->

    <div class="text-end mt-3">
        <a asp-controller="Borrows"
        asp-action="Index"
        class="btn btn-outline-primary">
            📖 View All Borrows →
        </a>
    </div>

   @section Scripts{

    <script>

    // Register Plugin
    Chart.register(ChartDataLabels);

    // Canvas
    const ctx = document.getElementById("ChartBorrowed");

    new Chart(ctx, {

        type: "bar",

        data: {

            labels: [
                "Borrowed",
                "Returned",
                "OverDue"
            ],

            datasets: [{

                label: "Library Statistics",

                data: [
                    @ViewBag.BorrowedCount,
                    @ViewBag.ReturnedCount,
                    @ViewBag.OverdueCount
                ],

                backgroundColor: [
                    "#0d6efd",
                    "#198754",
                    "#dc3545"
                ],

                borderRadius: 12,
                borderSkipped: false,
                maxBarThickness: 55

            }]
        },

        options: {

            responsive: true,
            maintainAspectRatio: false,

            animation: {
                duration: 1800,
                easing: "easeOutBounce"
            },

            plugins: {

                legend: {
                    display: false
                },

                tooltip: {
                    backgroundColor: "#212529",
                    titleColor: "#fff",
                    bodyColor: "#fff",
                    padding: 12,
                    cornerRadius: 8
                },

                datalabels: {

                    color: "#212529",

                    anchor: "end",

                    align: "top",

                    font: {
                        size: 16,
                        weight: "bold"
                    }

                }

            },

            scales: {

                x: {

                    grid: {
                        display: false
                    },

                    ticks: {

                        color: "#495057",

                        font: {
                            size: 15,
                            weight: "bold"
                        }

                    }

                },

                y: {

                    beginAtZero: true,

                    ticks: {

                        precision: 0,

                        stepSize: 1,

                        color: "#495057"

                    },

                    grid: {

                        color: "rgba(0,0,0,.08)"

                    }

                }

            }

        }

    });

    </script>


    }


<script>
    const monthCtx = document.getElementById("MonthlyChart");
    new Chart(monthCtx,{
        type: "line",
        data:{
            labels:[
            "Jan","Feb","Mar","Apr","May","Jun",
            "Jul","Aug","Sep","Oct","Nov","Dec"
            ],
            datasets:[{
                label:"Books Issued",
                data:[
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((object)ViewBag.MonthlyIssued)), 
                borderColor:#0d6efd",
                backgroundColor: "rgba(13,110,253,.15)",
                fill: true,
                tension: .4,
                pointRadius: 5,
                pointHoverRadius: 7
            }]
        },

        options:{
            responsive:true,
            maintainAspectRation:false
            plugins:{
                legend:{
                    display:false
                }
            },
            scales:{
                y:{
                    beginAtZero:true,
                    ticks:{
                        precision:0,
                        stepSize:1
                    }
                }
            }
        }

    });
</script>




















